# the app's own database (packages/db): workspaces, members, cases ...
DATABASE_URL=
# the corpus the ETL publishes (packages/etl_db): Neon sllaw-app, pooled URL, read-only from the app
ETL_DATABASE_URL=
# Vercel AI Gateway: every LLM call (on Vercel, OIDC replaces the key)
AI_GATEWAY_API_KEY=
# Cloudflare Workers AI: bge-m3 query vectors (packages/search)
CF_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Zilliz `chunks` (etl/embed.py)
ZILLIZ_URI=
ZILLIZ_TOKEN=
# model per task, "provider/model" as the gateway names it (defaults in packages/ai/src/models.ts)
MODEL_MAIN=
MODEL_RESEARCH=
MODEL_FILES=
