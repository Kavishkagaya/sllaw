# the app's own database (packages/db): users, workspaces, workspace_users, cases ...
DATABASE_URL=
# Clerk (empty in dev = keyless mode); the webhook (/api/webhooks/clerk) syncs users, workspaces, workspace_users
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
# the corpus the ETL publishes (packages/etl_db): Neon sllaw-app, pooled URL, read-only from the app
ETL_DATABASE_URL=
# Vercel AI Gateway: every LLM call (on Vercel, OIDC replaces the key)
AI_GATEWAY_API_KEY=
# Cloudflare Workers AI: bge-m3 query vectors (packages/search)
CF_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Zilliz `chunks` (etl/embed.py)
ZILLIZ_URI=
ZILLIZ_TOKEN=
# users' files (packages/storage): their own R2 bucket, with a CORS rule allowing PUT from the app's origin
# STORAGE=memory and FILE_INDEX=memory run the file pipelines without R2 or Zilliz (lost on restart)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_FILES_BUCKET=
STORAGE=
FILE_INDEX=
# OCR for scans and images (packages/extract, httpOcr): off unless OCR_URL is set. POST {url, mime, filename} with a
# signed GET url to the whole file -> {pages: [{n, text}]}. OCR_NAME goes into extract_by (change it with the provider)
OCR_URL=
OCR_TOKEN=
OCR_NAME=
# or Mistral OCR (~$4 per 1,000 pages): OCR_PROVIDER=mistral + MISTRAL_API_KEY; MISTRAL_OCR_MODEL pins a model
# (default mistral-ocr-latest). Leave OCR_PROVIDER empty to keep it off.
OCR_PROVIDER=
MISTRAL_API_KEY=
MISTRAL_OCR_MODEL=
# model per task, "provider/model" as the gateway names it (defaults in packages/ai/src/models.ts)
MODEL_MAIN=
MODEL_FILES=
