# Copy to .env and fill in. Never commit .env.

# Neon: console → project → Connection Details → Connection string
DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/dbname?sslmode=require

# Cloudflare R2: dashboard → R2 → bucket; API token with Object Read & Write on it
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=sllaw

# Cloudflare Workers AI (etl/label.py --provider cloudflare, Clef): dashboard → My Profile → API Tokens →
# Create Token → "Workers AI" template. Account id defaults to R2_ACCOUNT_ID.
CLOUDFLARE_API_TOKEN=
# optional: route through a Cloudflare AI Gateway (dashboard → AI → AI Gateway) for logs and caching
CF_AI_GATEWAY=
